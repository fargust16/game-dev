# Diagnostic output, written by the dump and validation tools outside Assets on
# purpose so the exports never show up as project churn.
unity/TerrainDump/
unity/TerrainValidation/

# The terrain-gen dumps write renders and per-run reports here. Only the regenerable
# output is ignored: unity/TerrainGenDump/stage3a_audit.txt is a kept audit and stays.
unity/TerrainGenDump/**/*.png
unity/TerrainGenDump/**/*_report.txt
unity/TerrainGenDump/**/*_sweep.txt
unity/TerrainGenDump/**/*_verify.txt

# Quarantined vendor code, kept on disk and deliberately out of the build.
unity/Assets/_Disabled/
unity/Assets/_Disabled.meta

# Test and editor logs
unity/*.log
unity/ShellTestLog.txt

# Editor backups
*.bak

# ---------------------------------------------------------------------------
# Code-generated assets: fully determined by source, nothing to author in them.
# Rebuilt by Rebuild Vegetation Assets and the player setup menu.
# The create-if-missing assets beside these stay tracked on purpose -- terrain
# layers carry Inspector tuning that code seeds once and must never restamp,
# so ignoring them would silently reset a world to code defaults on clone.
# ---------------------------------------------------------------------------
unity/Assets/Settings/Terrain/Vegetation/
unity/Assets/Settings/Terrain/Vegetation.meta
unity/Assets/Settings/OverworldPlayerAnimator.controller
unity/Assets/Settings/OverworldPlayerAnimator.controller.meta

# Baked lighting for the overworld scene
unity/Assets/Scenes/Overworld_Generator/
unity/Assets/Scenes/Overworld_Generator.meta
