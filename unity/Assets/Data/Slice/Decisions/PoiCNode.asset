    axes:
    - 1
    - 2
    approaches:
    - 2
    dialogueOptions:
    - threaten
    cost: "His Attitude"
    consequence: "He leaves the cellar; the drop stays on the shelf"
    opens: "The nook, unwatched"
    closes: "His offer"
    failure: "He takes the drop with him and leaves only the note (11.1: the watcher flees leaving only the note)"
    residue: []
    countsAsWithdraw: 0
    prepares: 1
    later: 
