  id: poi-c
  title: "Soot Stair Trace"
  situation: "Beneath the works' wall on Deaf Boiler Yard, the cellar door smells of soot and sweet chemical. Something was moved here after the arrest and the collectors' night. The player can read the trace, ask the sweep, sneak into the shuttered nook in the cellar, or leave the stairs to the rain; in the nook, or from a polite stranger in a too-clean coat, waits the black drop. (11.1 POI C, Slice build (S4))"
  poi: {fileID: 11400000, guid: 1afbb87f59ce4488b916e8e08b724d91, type: 2}
  scene: {fileID: 11400000, guid: 7d2b9e4c1a6f4b8e9c3d5f7a1b2c4e6d, type: 2}
  primaryAxis: 0
  secondaryAxis: 1
  options:
  - name: "Study the Physical Trace"
    axes:
    - 0
    - 1
    approaches:
    - 0
    - 4
    dialogueOptions: []
    cost: "Time: 20 minutes for the close look; a sweeper clears the easy tells at day 2, 20:00"
    consequence: "One solid tell linking A and B: Harrow's black tincture and the girls taken go down the same stair"
    opens: "A clearer crowned-buyer hypothesis; better Bargain judgment; an Argument against the stranger"
    closes: "None major"
    failure: "A misreading: soot and a chemical sweetness lie together, and no more"
    residue: []
    countsAsWithdraw: 0
    prepares: 0
    later: 
    inWorld: "TraceSpot"
  - name: "Talk to the sweep"
    axes:
    - 0
    - 1
    approaches:
    - 1
    - 2
    - 3
    dialogueOptions: []
    cost: "A service of 30 minutes, or his enmity"
    consequence: "A crestless coach, its men speaking like the clerks up the hill"
    opens: "Social confirmation of the class divide behind the crime"
    closes: "If Threaten, the sweep leaves for good"
    failure: "Silence; the trace on the ground stays"
    residue: []
    countsAsWithdraw: 0
    prepares: 0
    later: 
    inWorld: "PoiStage (SweepDialogue)"
