    axes:
    - 0
    - 1
    approaches:
    - 0
    - 4
    dialogueOptions:
    - unfold
    - unfold_empty
    - hear
    cost: "Trespass; the Bargain's temptation"
    consequence: "The note and the black drop, or the stranger's offer if he sees the character"
    opens: "The Bargain tease"
    closes: "Nothing yet"
    failure: "Seen: the stranger steps in and makes the offer himself"
    residue: []
    countsAsWithdraw: 0
    prepares: 0
