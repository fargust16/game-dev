MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: daba6ea9630b46e1a1baf990becb33e7, type: 3}
  m_Name: Tips
  m_EditorClassIdentifier: 
  tips:
  - id: board.girls
    source: 0
    day: 1
    fromMinute: 480
    poi: {fileID: 11400000, guid: 5bbaf1dc5f44490bb3d32f8359246335, type: 2}
    effect: 1
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 0
    line: "MISSING. Mill girls, gone near Loom Lane. The paper's edges are greased by sooty thumbs."
    note: "A notice on the board: mill girls have gone missing near Loom Lane."
  - id: board.wren
    source: 0
    day: 0
    fromMinute: 0
    poi: {fileID: 0}
    effect: 0
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 0
    line: "MISSING. Thomas Wren, clerk at the mill. Any word to his sister, Lottie Wren, at the Soot & Bell."
    note: "Thomas Wren, a clerk at the mill, is missing. His sister Lottie posted the notice."
  - id: board.seizure
    source: 0
    day: 1
    fromMinute: 840
    poi: {fileID: 11400000, guid: 1d3d9d0cb6654077ac21992cc277ad91, type: 2}
    effect: 2
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 0
    line: "WARDEN SEIZURE NOTICE. Harrow & Tincture, Bell Street, before the second-shift bell. By order, brass number 14."
    note: "The Wardens posted a seizure notice for Harrow & Tincture on Bell Street, to be done before the second-shift bell."
  - id: nell.harrow
    source: 1
    day: 1
    fromMinute: 960
    poi: {fileID: 11400000, guid: 1d3d9d0cb6654077ac21992cc277ad91, type: 2}
    effect: 2
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 0
    line: "Brass-numbers are taking old Harrow tonight. Say he sold black tincture to mill hands. If you care, go before the whistle. After that it's paperwork and padlocks."
    note: "Nell says the Wardens mean to take old Harrow tonight, for selling black tincture to mill hands."
  - id: nell.collectors
    source: 1
    day: 1
    fromMinute: 960
    poi: {fileID: 11400000, guid: 5bbaf1dc5f44490bb3d32f8359246335, type: 2}
    effect: 2
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 1
    line: "After the eleventh bell they take mill girls off Loom Lane. Tonight again."
    note: "Nell says mill girls are taken off Loom Lane after the eleventh bell."
  - id: nell.chalk
    source: 1
    day: 2
    fromMinute: 960
    poi: {fileID: 11400000, guid: 1afbb87f59ce4488b916e8e08b724d91, type: 2}
    effect: 2
    requiresKey: poi.c.phase
    requiresAtLeast: 1
    needsApproach: 0
    line: "Lane's wrong. Coal stairs got fresh chalk. Rain'll wash it by midweek."
    note: "Nell says there is fresh chalk on the coal stairs."
  - id: kit.drawers
    source: 2
    day: 1
    fromMinute: 480
    poi: {fileID: 11400000, guid: 1d3d9d0cb6654077ac21992cc277ad91, type: 2}
    effect: 1
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 0
    line: "They want the drawers more than the man."
    note: "The newsboy says they want the drawers more than the man."
  - id: kit.coachcoats
    source: 2
    day: 1
    fromMinute: 480
    poi: {fileID: 11400000, guid: 5bbaf1dc5f44490bb3d32f8359246335, type: 2}
    effect: 1
    requiresKey: 
    requiresAtLeast: 1
    needsApproach: 0
    line: "Collectors in coach-coats. Not proper cabmen."
    note: "The newsboy talks of collectors in coach-coats, not proper cabmen."
  - id: kit.seal
    source: 2
    day: 2
    fromMinute: 480
    poi: {fileID: 11400000, guid: 1afbb87f59ce4488b916e8e08b724d91, type: 2}
    effect: 1
    requiresKey: aftermath.harrow.shop_sealed
    requiresAtLeast: 1
    needsApproach: 0
    line: "Wax seal melted funny on Harrow's door."
    note: "The newsboy says the wax seal on Harrow's door melted oddly."
  - id: kit.glove
    source: 2
    day: 2
    fromMinute: 480
    poi: {fileID: 11400000, guid: 1afbb87f59ce4488b916e8e08b724d91, type: 2}
    effect: 1
    requiresKey: poi.b.phase
    requiresAtLeast: 2
    needsApproach: 0
    line: "Glove by the coach ruts, down Loom Lane."
    note: "The newsboy says there was a glove by the coach ruts on Loom Lane."
