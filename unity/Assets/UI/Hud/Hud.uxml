<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <!-- Every word is a string table key (17 X.7): a label of the class hud__loc carries its key as its text; the others are written by HudView. -->
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:Label name="time" class="hud__time" text="" picking-mode="Ignore" />
        <ui:Label name="prompt" class="hud__prompt" text="" picking-mode="Ignore" />
        <!-- A Screen Message: an outcome or a hint, 2–3 s on the screen and never in the prompt (owner, 2026-11-12). -->
        <ui:Label name="message" class="hud__message" text="" picking-mode="Ignore" />
        <ui:Label name="nametag" class="hud__nametag" text="" picking-mode="Ignore" />
        <!-- S3a.7: the character's HP and conditions while it is hurt, and the last treatment. -->
        <ui:Label name="life" class="hud__life" text="" picking-mode="Ignore" />
        <ui:VisualElement name="reading" class="hud__reading" picking-mode="Ignore">
            <ui:Label name="reading-title" class="hud__reading-title" text="" picking-mode="Ignore" />
            <ui:Label name="reading-text" class="hud__reading-text" text="" picking-mode="Ignore" />
            <ui:Label class="hud__reading-close hud__loc" text="ui.hud.reading.close" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="map" class="hud__map">
            <ui:Label class="hud__notes-title hud__loc" text="ui.hud.map.title" picking-mode="Ignore" />
            <ui:VisualElement name="map-area" class="hud__map-area" picking-mode="Ignore" />
            <ui:Label class="hud__reading-close hud__loc" text="ui.hud.map.close" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="dialogue" class="hud__dialogue" picking-mode="Ignore">
            <ui:ScrollView name="dialogue-lines" class="hud__dialogue-lines" />
            <ui:VisualElement name="dialogue-options" class="hud__dialogue-options" picking-mode="Ignore" />
            <ui:Label class="hud__reading-close hud__loc" text="ui.hud.dialogue.close" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- S3a.5: the fight. FightHud writes it. The hotbar (owner's play test, 2026-11-11, after BG3's): the player's HP
             and AP over a row of action slots, each an icon with its key; FightHud fills the slots and the tip over them. -->
        <ui:VisualElement name="fight" class="hud__fight" picking-mode="Ignore">
            <ui:VisualElement name="fight-order" class="hud__fight-order" picking-mode="Ignore" />
            <ui:Label name="fight-who" class="hud__fight-who" text="" picking-mode="Ignore" />
            <ui:Label name="fight-log" class="hud__fight-log" text="" picking-mode="Ignore" />
            <ui:VisualElement name="fight-bar" class="hud__fight-bar" picking-mode="Ignore">
                <ui:VisualElement name="fight-panel" class="hud__fight-panel">
                    <ui:VisualElement class="hud__fight-status" picking-mode="Ignore">
                        <ui:Label name="fight-hp" class="hud__fight-hp" text="" picking-mode="Ignore" />
                        <ui:VisualElement name="fight-ap" class="hud__fight-ap" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fight-actions" class="hud__fight-actions" picking-mode="Ignore" />
                    <ui:Label class="hud__fight-camera hud__loc" text="ui.fight.camera" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="fight-action-tip" class="hud__fight-action-tip" text="" picking-mode="Ignore" />
            <ui:Label name="fight-tip" class="hud__fight-tip" text="" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="notes" class="hud__notes">
            <ui:Label class="hud__notes-title hud__loc" text="ui.hud.notes.title" picking-mode="Ignore" />
            <ui:ScrollView name="notes-list" class="hud__notes-list" />
            <ui:Label class="hud__reading-close hud__loc" text="ui.hud.notes.close" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="shop" class="hud__notes">
            <ui:Label name="shop-title" class="hud__notes-title" text="" picking-mode="Ignore" />
            <ui:Label name="shop-money" class="hud__note" text="" picking-mode="Ignore" />
            <!-- S5b.1: a text field the page may show, the character's name at creation. -->
            <ui:TextField name="shop-field" class="hud__field" style="display: none;" />
            <ui:ScrollView name="shop-list" class="hud__notes-list" />
            <ui:Label name="shop-note" class="hud__bag-note" text="" picking-mode="Ignore" />
            <ui:Label name="shop-close" class="hud__reading-close hud__loc" text="ui.hud.shop.close" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="bag" class="hud__notes">
            <ui:Label class="hud__notes-title hud__loc" text="ui.hud.bag.title" picking-mode="Ignore" />
            <ui:Label name="bag-money" class="hud__note" text="" picking-mode="Ignore" />
            <ui:Label name="bag-load" class="hud__note" text="" picking-mode="Ignore" />
            <ui:ScrollView name="bag-list" class="hud__notes-list" />
            <ui:Label name="bag-note" class="hud__bag-note" text="" picking-mode="Ignore" />
            <ui:Label class="hud__reading-close hud__loc" text="ui.hud.bag.close" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- The menu on Esc (owner, 2026-11-12): Esc closes any window open, and with none it opens this and closes it again. -->
        <ui:VisualElement name="menu" class="hud__notes hud__menu">
            <ui:Label name="menu-title" class="hud__notes-title hud__loc" text="ui.hud.menu.title" picking-mode="Ignore" />
            <ui:Label name="start-title" class="hud__notes-title hud__loc" text="ui.hud.start.title" picking-mode="Ignore" style="display: none;" />
            <ui:Label name="menu-resume" class="hud__note hud__bag-action hud__loc" text="ui.hud.menu.resume" />
            <ui:Label name="menu-language" class="hud__note hud__bag-action hud__loc" text="ui.hud.menu.language" />
            <ui:Label name="menu-save" class="hud__note hud__bag-action hud__loc" text="ui.hud.menu.save" />
            <ui:Label name="menu-quit" class="hud__note hud__bag-action hud__loc" text="ui.hud.menu.quit" />
            <ui:Label name="start-continue" class="hud__note hud__bag-action hud__loc" text="ui.hud.start.continue" style="display: none;" />
            <ui:Label name="start-new" class="hud__note hud__bag-action hud__loc" text="ui.hud.start.new" style="display: none;" />
            <ui:Label name="menu-close" class="hud__reading-close hud__loc" text="ui.hud.menu.close" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
