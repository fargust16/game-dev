<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:Label name="time" class="hud__time" text="Day 1 · 08:00" picking-mode="Ignore" />
        <ui:Label name="prompt" class="hud__prompt" text="E  Enter" picking-mode="Ignore" />
        <ui:VisualElement name="reading" class="hud__reading" picking-mode="Ignore">
            <ui:Label name="reading-title" class="hud__reading-title" text="Notice Board" picking-mode="Ignore" />
            <ui:Label name="reading-text" class="hud__reading-text" text="" picking-mode="Ignore" />
            <ui:Label class="hud__reading-close" text="E  Close" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
