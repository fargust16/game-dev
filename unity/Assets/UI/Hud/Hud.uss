.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__time {
    position: absolute;
    top: 16px;
    right: 24px;
    font-size: 22px;
    color: rgb(236, 228, 210);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.hud__prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22%;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(236, 228, 210);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    display: none;
}

.hud__prompt--visible {
    display: flex;
}

/* The plain panel of S1.3: what a source says, until S2's dialogue replaces it. */
.hud__reading {
    position: absolute;
    left: 30%;
    right: 30%;
    bottom: 28%;
    padding: 18px 22px;
    background-color: rgba(24, 20, 16, 0.88);
    border-width: 1px;
    border-color: rgb(120, 104, 80);
    display: none;
}

.hud__reading--visible {
    display: flex;
}

.hud__reading-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 228, 210);
    margin-bottom: 10px;
}

.hud__reading-text {
    font-size: 19px;
    white-space: normal;
    color: rgb(236, 228, 210);
}

.hud__reading-close {
    font-size: 16px;
    margin-top: 12px;
    -unity-text-align: middle-right;
    color: rgb(190, 178, 156);
}
