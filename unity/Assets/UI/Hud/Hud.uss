.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud__time {
    position: absolute;
    top: 16px;
    right: 24px;
    font-size: 22px;
    color: rgb(236, 228, 210);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.hud__prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22%;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(236, 228, 210);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    display: none;
}

.hud__prompt--visible {
    display: flex;
}

/* The plain panel of S1.3: what a board says. People talk in the dialogue column of S2.4. */
.hud__reading {
    position: absolute;
    left: 30%;
    right: 30%;
    bottom: 28%;
    padding: 18px 22px;
    background-color: rgba(24, 20, 16, 0.88);
    border-width: 1px;
    border-color: rgb(120, 104, 80);
    display: none;
}

.hud__reading--visible {
    display: flex;
}

.hud__reading-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(236, 228, 210);
    margin-bottom: 10px;
}

.hud__reading-text {
    font-size: 19px;
    white-space: normal;
    color: rgb(236, 228, 210);
}

.hud__reading-close {
    font-size: 16px;
    margin-top: 12px;
    -unity-text-align: middle-right;
    color: rgb(190, 178, 156);
}

/* The Character Notes of S1.4: one line for each fact found, in order, and nothing that says what to do. */
.hud__notes {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 12%;
    bottom: 12%;
    padding: 20px 26px;
    background-color: rgba(30, 26, 20, 0.94);
    border-width: 1px;
    border-color: rgb(120, 104, 80);
    display: none;
}

.hud__notes--visible {
    display: flex;
}

.hud__notes-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(236, 228, 210);
    margin-bottom: 12px;
}

.hud__notes-list {
    flex-grow: 1;
}

.hud__note {
    font-size: 18px;
    white-space: normal;
    color: rgb(236, 228, 210);
    margin-bottom: 10px;
}

/* S1.5: the name of the nearest named person, over their head. */
.hud__nametag {
    position: absolute;
    font-size: 18px;
    color: rgb(236, 228, 210);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    translate: -50% -100%;
    display: none;
}

.hud__nametag--visible {
    display: flex;
}

/* S1.6: the map on M, the city plan with Marked POIs as pins and Hinted ones as areas. */
.hud__map {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 5%;
    bottom: 5%;
    padding: 16px 20px;
    background-color: rgba(30, 26, 20, 0.95);
    border-width: 1px;
    border-color: rgb(120, 104, 80);
    display: none;
}

.hud__map--visible {
    display: flex;
}

.hud__map-area {
    flex-grow: 1;
    overflow: hidden;
}

.hud__map-mark {
    font-size: 16px;
    color: rgb(40, 20, 10);
    background-color: rgba(255, 250, 235, 0.85);
    padding: 1px 4px;
    -unity-font-style: bold;
}

/* S2.4: a conversation, a column at the right edge as in Disco Elysium (owner, 2026-11-09): what was said above, the
   latest at the bottom, the numbered options below, and the scene visible to its left. */
.hud__dialogue {
    position: absolute;
    right: 24px;
    top: 56px;
    bottom: 24px;
    width: 30%;
    min-width: 360px;
    padding: 18px 22px;
    background-color: rgba(24, 20, 16, 0.9);
    border-width: 1px;
    border-color: rgb(120, 104, 80);
    display: none;
}

.hud__dialogue--visible {
    display: flex;
}

.hud__dialogue-lines {
    flex-grow: 1;
    flex-shrink: 1;
}

.hud__dialogue-speaker {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(214, 176, 112);
    margin-top: 10px;
}

.hud__dialogue-line {
    font-size: 18px;
    white-space: normal;
    color: rgb(236, 228, 210);
    margin-bottom: 4px;
}

.hud__dialogue-options {
    flex-shrink: 0;
    margin-top: 14px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: rgb(120, 104, 80);
}

.hud__dialogue-option {
    font-size: 18px;
    white-space: normal;
    color: rgb(222, 196, 150);
    margin-bottom: 8px;
}
