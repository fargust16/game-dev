# The repository decides normalisation, not each machine's Git installer.
# core.autocrlf currently comes from Git-for-Windows' system config, so without this
# file the policy is whatever a contributor happened to install. Every tracked text
# blob is already LF, so this records the existing state rather than changing it.
* text=auto

# Auto-detection already classifies these correctly. Stating them keeps a future file
# of the same type safe if it happens to carry no NUL byte in its first 8000 bytes.
*.png binary
*.fbx binary
*.tgz binary

# The slice terrain's CC0 texture sets (tools/assets/fetch_terrain_textures.py; owner, 2026-11-14): large and required,
# so they go through Git LFS. MANIFEST.json beside them names each file's source and MD5.
unity/Assets/Art/CC0/Terrain/**/*.jpg filter=lfs diff=lfs merge=lfs -text
unity/Assets/Art/CC0/Terrain/**/*.png filter=lfs diff=lfs merge=lfs -text

# Shell scripts break on CRLF, so they stay LF on every checkout.
*.sh text eol=lf
